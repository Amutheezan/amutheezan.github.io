---
layout: none
---
[
  {% assign all_items = site.publications | concat: site.talks | concat: site.workshops | concat: site.projects %}
  {% for item in all_items %}
    {
      "id": {{ forloop.index }},
      "title": {{ item.title | jsonify }},
      "url": {{ item.url | prepend: site.baseurl | jsonify }},
      "collection": {{ item.collection | jsonify }},
      "venue": {{ item.venue | default: "" | jsonify }},
      "date": {{ item.date | date: "%Y" | jsonify }},
      "citation": {{ item.citation | default: "" | jsonify }},
      "content": {{ item.content | strip_html | strip_newlines | truncatewords: 60 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
